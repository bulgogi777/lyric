---
import Layout from '../layouts/Layout.astro';
import SongCard from '../components/SongCard.astro';
import songs from '../../data/songs.json';

// Sort songs: with lyrics first, then without
const sortedSongs = [...songs].sort((a, b) => {
  if (a.hasLyrics && !b.hasLyrics) return -1;
  if (!a.hasLyrics && b.hasLyrics) return 1;
  return 0;
});

const withLyrics = songs.filter(s => s.hasLyrics).length;
---

<Layout title="歌词学习 · Chinese Lyrics Study">
  <div class="space-y-6">
    <div class="text-center">
      <h1 class="text-3xl font-bold mb-2">中文歌词学习</h1>
      <p class="text-text-muted">
        {songs.length} 首歌曲 · {withLyrics} 有歌词
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {sortedSongs.map((song) => (
        <SongCard
          id={song.id}
          title={song.title}
          artist={song.artist}
          hasLyrics={song.hasLyrics}
        />
      ))}
    </div>
  </div>
</Layout>
