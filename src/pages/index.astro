---
import Layout from '../layouts/Layout.astro';
import SongCard from '../components/SongCard.astro';
import songs from '../../data/songs.json';

// Sort songs: newest first (reversed playlist order), with lyrics before without
const sortedSongs = [...songs].reverse().sort((a, b) => {
  if (a.hasLyrics && !b.hasLyrics) return -1;
  if (!a.hasLyrics && b.hasLyrics) return 1;
  return 0;
});

const withLyrics = songs.filter(s => s.hasLyrics).length;
---

<Layout title="Chinese Lyrics Study">
  <div class="space-y-6">
    <div class="text-center">
      <h1 class="text-3xl font-bold mb-2">Chinese Lyrics Study</h1>
      <p class="text-text-muted">
        {songs.length} songs · {withLyrics} with lyrics
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {sortedSongs.map((song) => (
        <SongCard
          id={song.id}
          title={song.title}
          artist={song.artist}
          hasLyrics={song.hasLyrics}
        />
      ))}
    </div>
  </div>
</Layout>
