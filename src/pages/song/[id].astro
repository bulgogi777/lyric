---
import Layout from '../../layouts/Layout.astro';
import YouTubePlayer from '../../components/YouTubePlayer.astro';
import LyricsDisplay from '../../components/LyricsDisplay.astro';
import songs from '../../../data/songs.json';

export function getStaticPaths() {
  return songs.map((song) => ({
    params: { id: song.id },
    props: { song },
  }));
}

const { song } = Astro.props;
---

<Layout title={`${song.title} - ${song.artist} · Chinese Lyrics Study`}>
  <div class="space-y-6">
    <!-- Back link -->
    <a href="/" class="text-primary hover:text-primary-dark inline-flex items-center gap-2 no-print">
      ← Back to playlist
    </a>

    <!-- Song header -->
    <div class="text-center">
      <h1 class="text-3xl font-bold mb-2">{song.title}</h1>
      <p class="text-text-muted text-lg">{song.artist}</p>
      {song.album && <p class="text-text-muted text-sm">Album: {song.album}</p>}

      <!-- Character mode toggle -->
      <div class="char-toggle no-print" id="char-toggle">
        <button class="char-toggle-btn" data-mode="simplified">简体</button>
        <button class="char-toggle-btn" data-mode="traditional">繁體</button>
      </div>
    </div>

    <script>
      const toggle = document.getElementById('char-toggle');
      const buttons = toggle?.querySelectorAll('.char-toggle-btn');
      const initialMode = localStorage.getItem('charMode') || 'simplified';

      buttons?.forEach(btn => {
        const mode = btn.getAttribute('data-mode');
        btn.classList.toggle('active', mode === initialMode);
      });

      buttons?.forEach(btn => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-mode') || 'simplified';
          buttons!.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          localStorage.setItem('charMode', mode);
          window.dispatchEvent(new CustomEvent('charModeToggle', { detail: { mode } }));
        });
      });
    </script>

    <!-- Main content: Player + Lyrics -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- YouTube Player (sticky on desktop) -->
      <div class="lg:col-span-1">
        <YouTubePlayer videoId={song.id} />
      </div>

      <!-- Lyrics -->
      <div class="lg:col-span-2">
        {song.hasLyrics && song.lyrics ? (
          <LyricsDisplay lyrics={song.lyrics} />
        ) : (
          <div class="bg-surface rounded-lg p-8 text-center">
            <p class="text-xl mb-4">Lyrics not found</p>
            <p class="text-text-muted mb-4">This song needs lyrics added manually</p>
            <a
              href={`/admin/${song.id}`}
              class="inline-block bg-primary hover:bg-primary-dark px-6 py-3 rounded transition-colors"
            >
              Add Lyrics
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
