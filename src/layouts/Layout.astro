---
interface Props {
  title?: string;
}

const { title = 'Chinese Lyrics Study' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts for Chinese -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet">

    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <header class="bg-surface border-b border-slate-700 no-print">
      <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-xl font-bold text-primary hover:text-primary-dark">
          🎵 歌词学习
        </a>
        <nav class="text-sm text-text-muted">
          Chinese Lyrics Study
        </nav>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="bg-surface border-t border-slate-700 mt-auto no-print">
      <div class="max-w-4xl mx-auto px-4 py-4 text-center text-sm text-text-muted">
        学习中文 · Learning Chinese through Music
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
