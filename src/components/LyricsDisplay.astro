---
interface LyricLine {
  timestamp?: string;
  chinese: string;
  pinyin: string;
  english: string;
}

interface Props {
  lyrics: LyricLine[];
}

const { lyrics } = Astro.props;

// Convert timestamp to seconds
function timestampToSeconds(timestamp: string): number {
  const parts = timestamp.split(':');
  const minutes = parseInt(parts[0], 10);
  const seconds = parseFloat(parts[1]);
  return minutes * 60 + seconds;
}

// Check if translation looks like LLM error (contains code/file references)
function isValidTranslation(text: string): boolean {
  const errorPatterns = [
    /I will/i,
    /I'll/i,
    /\.md`/,
    /`.*`/,
    /directory/i,
    /file/i,
    /check.*translation/i,
    /read.*to understand/i,
  ];
  return !errorPatterns.some(p => p.test(text));
}
---

<div class="lyrics-container" id="lyrics-container">
  {lyrics.map((line, index) => (
    <div
      class="lyric-block"
      id={`lyric-${index}`}
      data-timestamp={line.timestamp ? timestampToSeconds(line.timestamp) : undefined}
    >
      {line.timestamp && (
        <button
          class="timestamp"
          onclick={`seekToTime(${timestampToSeconds(line.timestamp)})`}
        >
          [{line.timestamp}]
        </button>
      )}
      <div class="lyric-content">
        <div class="chinese">{line.chinese}</div>
        <div class="pinyin">{line.pinyin}</div>
        {isValidTranslation(line.english) && (
          <div class="english">{line.english}</div>
        )}
      </div>
    </div>
  ))}
</div>

<script>
  // Auto-scroll to current lyric based on player time
  let currentHighlightedIndex = -1;

  window.addEventListener('playerTimeUpdate', (event: Event) => {
    const customEvent = event as CustomEvent<{ time: number }>;
    const currentTime = customEvent.detail.time;

    // Find all lyric blocks with timestamps
    const blocks = document.querySelectorAll('.lyric-block[data-timestamp]');
    let targetIndex = -1;

    // Find the current lyric (last one whose timestamp is <= current time)
    blocks.forEach((block, index) => {
      const timestamp = parseFloat(block.getAttribute('data-timestamp') || '0');
      if (timestamp <= currentTime) {
        targetIndex = index;
      }
    });

    // Only update if we found a new line
    if (targetIndex !== currentHighlightedIndex && targetIndex >= 0) {
      // Remove highlight from previous
      if (currentHighlightedIndex >= 0) {
        blocks[currentHighlightedIndex]?.classList.remove('active');
      }

      // Add highlight to current
      const currentBlock = blocks[targetIndex] as HTMLElement;
      if (currentBlock) {
        currentBlock.classList.add('active');

        // Scroll to the current block with smooth behavior
        currentBlock.scrollIntoView({
          behavior: 'smooth',
          block: 'center',
        });
      }

      currentHighlightedIndex = targetIndex;
    }
  });
</script>

<style>
  .lyrics-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .lyric-block {
    border-left: 3px solid #334155;
    padding: 1rem 0 1rem 1.25rem;
    transition: all 0.1s ease;
  }

  .lyric-block:hover {
    border-left-color: #3b82f6;
    background: linear-gradient(to right, rgba(59, 130, 246, 0.08), transparent);
  }

  .lyric-block.active {
    border-left-color: #22c55e;
    background: linear-gradient(to right, rgba(34, 197, 94, 0.15), transparent);
  }

  .lyric-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .timestamp {
    display: block;
    margin-bottom: 0.5rem;
  }

  @media print {
    .lyric-block {
      border-left-color: #ccc;
      break-inside: avoid;
      page-break-inside: avoid;
      padding: 0.75rem 0 0.75rem 1rem;
    }

    .lyric-block.active {
      border-left-color: #ccc;
      background: none;
    }

    .lyrics-container {
      gap: 1rem;
    }
  }
</style>
